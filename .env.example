# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Spring Boot-> FastAPI 요청 URL
SUPABASE_URL=SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Java -> FastAPI internal URL
AI_SERVICE_URL=http://ai-api:8000
SPRING_BASE_URL=http://java-backend:8080

# 파이프라인에서 GPT 요약과 임베딩 Batch API 호출에 사용하는 OpenAI API key
OPENAI_API_KEY=change-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

EMBEDDING_DIMENSIONS=1536
RECOMMENDATION_TOP_K=3
RECOMMENDATION_CANDIDATE_POOL_SIZE=50
